MONGO_URI=
MONGO_TEST_URI=
JWT_SECRET=
PORT=5000
# Transactional email (HTTPS API, works with Render Free).
# Create and keep RESEND_API_KEY only in Render backend environment variables.
# Verify verifiedng.site or mail.verifiedng.site in Resend before setting sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VerifiedNG <no-reply@verifiedng.site>
RESET_FRONTEND_URL=https://verifiedng.site
# Legacy Gmail SMTP keys are no longer used for password resets.
PROVIDER_INVITE_CODE=
FRONTEND_URL=http://localhost:5500
# Optional: publisher news (backend only, never put in VITE_ variables)
GNEWS_API_KEY=
# Optional: verify marketplace photo URLs belong to your Cloudinary account
CLOUDINARY_CLOUD_NAME=
# Signed Cloudinary uploads. NEVER place API_SECRET in frontend Vite or Vercel.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=verifiedng_community
# Optional: comma-separated trusted MongoDB User _id values (NOT emails)
VERIFICATION_ADMIN_USER_IDS=
