# Optional backend URL for local development.
VITE_API_BASE_URL=http://localhost:5000
# Cloudinary photo/video uploads use a signed backend endpoint, not VITE_ secrets.
# Set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# and CLOUDINARY_UPLOAD_PRESET in the backend environment.

# For a Vercel PR Preview, configure VITE_API_BASE_URL to an isolated staging
# Render backend in Vercel Preview ONLY. Never use the production Render URL.
# Without staging, previews remain viewable but API requests are blocked.
